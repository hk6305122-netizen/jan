# WalkTrack environment variables

# Backend
PORT=4000
NODE_ENV=development

# Postgres (choose ONE approach)

# Option A: connection string
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/walktrack

# Option B: individual settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=walktrack
DB_USER=postgres
DB_PASSWORD=postgres

# If using managed Postgres that requires SSL, uncomment:
# PGSSLMODE=require
